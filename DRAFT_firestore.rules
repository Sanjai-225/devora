rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net — default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Global Primitives ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isParentProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // ── Entity Validation Blueprints ────────────────────────────────
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.role is string && data.role.size() <= 32 && data.role == 'individual'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'name',
          'description',
          'status',
          'designChoice',
          'currentAgentStage',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'description',
          'status',
          'designChoice',
          'currentAgentStage',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == projectId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 10000
        && data.status is string && data.status.size() <= 40 && data.status in [
          'draft',
          'analyzing',
          'clarifying',
          'designing',
          'awaiting_design_approval',
          'configuring',
          'planning',
          'awaiting_plan_approval',
          'building',
          'testing',
          'repairing',
          'ready',
          'failed',
          'archived'
        ]
        && data.designChoice is string && data.designChoice.size() <= 32 && data.designChoice in ['design_first', 'direct_code', 'pending']
        && data.currentAgentStage is string && data.currentAgentStage.size() >= 1 && data.currentAgentStage.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversationMessage(data, projectId, messageId) {
      return data.keys().hasAll(['id', 'projectId', 'userId', 'role', 'content', 'stage', 'createdAt'])
        && data.keys().hasOnly(['id', 'projectId', 'userId', 'role', 'content', 'stage', 'createdAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == messageId
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId == projectId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.role is string && data.role.size() <= 16 && data.role in ['user', 'agent', 'system']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 10000
        && data.stage is string && data.stage.size() >= 1 && data.stage.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidDesignVersion(data, projectId, versionId) {
      return data.keys().hasAll([
          'id',
          'projectId',
          'userId',
          'versionNumber',
          'versionTag',
          'label',
          'prompt',
          'primaryColor',
          'surfaceColor',
          'borderRadius',
          'prototypeCode',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'projectId',
          'userId',
          'versionNumber',
          'versionTag',
          'label',
          'prompt',
          'primaryColor',
          'surfaceColor',
          'borderRadius',
          'prototypeCode',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == versionId
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId == projectId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.versionNumber is int && data.versionNumber >= 1 && data.versionNumber <= 1000
        && data.versionTag is string && data.versionTag.size() >= 2 && data.versionTag.size() <= 24
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 5000
        && data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 32
        && data.surfaceColor is string && data.surfaceColor.size() >= 4 && data.surfaceColor.size() <= 32
        && data.borderRadius is string && data.borderRadius.size() >= 2 && data.borderRadius.size() <= 16
        && data.prototypeCode is string && data.prototypeCode.size() >= 1 && data.prototypeCode.size() <= 50000
        && data.approved is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectConfiguration(data, projectId, configId) {
      return data.keys().hasAll([
          'id',
          'projectId',
          'userId',
          'variableKey',
          'maskedValue',
          'category',
          'scope',
          'encryptionType',
          'isRequired',
          'isConfigured',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'projectId',
          'userId',
          'variableKey',
          'maskedValue',
          'category',
          'scope',
          'encryptionType',
          'isRequired',
          'isConfigured',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == configId
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId == projectId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.variableKey is string && data.variableKey.size() >= 1 && data.variableKey.size() <= 128
        && data.maskedValue is string && data.maskedValue.size() <= 512
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 32
        && data.scope is string && data.scope.size() <= 32 && data.scope in ['server_only', 'client_public']
        && data.encryptionType is string && data.encryptionType.size() >= 1 && data.encryptionType.size() <= 32
        && data.isRequired is bool
        && data.isConfigured is bool
        && data.updatedAt is timestamp;
    }

    function isValidImplementationPlan(data, projectId, planId) {
      return data.keys().hasAll([
          'id',
          'projectId',
          'userId',
          'planTitle',
          'architectureSummary',
          'estimatedFilesCount',
          'estimatedDurationSeconds',
          'stepsCount',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'projectId',
          'userId',
          'planTitle',
          'architectureSummary',
          'estimatedFilesCount',
          'estimatedDurationSeconds',
          'stepsCount',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == planId
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId == projectId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.planTitle is string && data.planTitle.size() >= 1 && data.planTitle.size() <= 200
        && data.architectureSummary is string && data.architectureSummary.size() >= 1 && data.architectureSummary.size() <= 2000
        && data.estimatedFilesCount is int && data.estimatedFilesCount >= 1 && data.estimatedFilesCount <= 500
        && data.estimatedDurationSeconds is int && data.estimatedDurationSeconds >= 1 && data.estimatedDurationSeconds <= 3600
        && data.stepsCount is int && data.stepsCount >= 1 && data.stepsCount <= 50
        && data.approved is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceInstance(data, projectId, workspaceId) {
      return data.keys().hasAll([
          'id',
          'projectId',
          'userId',
          'status',
          'allocatedPort',
          'processId',
          'previewUrl',
          'hostingTier',
          'filesCount',
          'lastCommand',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'projectId',
          'userId',
          'status',
          'allocatedPort',
          'processId',
          'previewUrl',
          'hostingTier',
          'filesCount',
          'lastCommand',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id == workspaceId
        && data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId == projectId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.status is string && data.status.size() <= 24 && data.status in ['stopped', 'starting', 'running', 'error']
        && data.allocatedPort is int && data.allocatedPort >= 0 && data.allocatedPort <= 65535
        && data.processId is int && data.processId >= 0 && data.processId <= 4194304
        && data.previewUrl is string && data.previewUrl.size() <= 512
        && data.hostingTier is string && data.hostingTier.size() >= 1 && data.hostingTier.size() <= 32
        && data.filesCount is int && data.filesCount >= 0 && data.filesCount <= 10000
        && data.lastCommand is string && data.lastCommand.size() >= 1 && data.lastCommand.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ── /users/{userId} ─────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);

      allow delete: if false;
    }

    // ── /projects/{projectId} ───────────────────────────────────────
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming(), projectId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming(), projectId)
        && existing().userId == request.auth.uid
        && existing().status != 'archived'
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update project details or workflow status
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'description',
            'status',
            'designChoice',
            'currentAgentStage',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() && isValidId(projectId) && existing().userId == request.auth.uid;

      // ── /projects/{projectId}/conversations/{messageId} ───────────
      match /conversations/{messageId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(messageId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);

        allow list: if isSignedIn()
          && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(messageId)
          && isValidConversationMessage(incoming(), projectId, messageId)
          && incoming().createdAt == request.time
          && isParentProjectOwner(projectId);

        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(messageId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);
      }

      // ── /projects/{projectId}/designVersions/{versionId} ──────────
      match /designVersions/{versionId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(versionId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);

        allow list: if isSignedIn()
          && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(versionId)
          && isValidDesignVersion(incoming(), projectId, versionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentProjectOwner(projectId);

        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(versionId)
          && isValidDesignVersion(incoming(), projectId, versionId)
          && existing().userId == request.auth.uid
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().userId == existing().userId
          && incoming().versionNumber == existing().versionNumber
          && incoming().versionTag == existing().versionTag
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'approved',
            'primaryColor',
            'surfaceColor',
            'borderRadius',
            'prototypeCode',
            'updatedAt'
          ])
          && isParentProjectOwner(projectId);

        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(versionId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);
      }

      // ── /projects/{projectId}/configurations/{configId} ───────────
      match /configurations/{configId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(configId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);

        allow list: if isSignedIn()
          && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(configId)
          && isValidProjectConfiguration(incoming(), projectId, configId)
          && incoming().updatedAt == request.time
          && isParentProjectOwner(projectId);

        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(configId)
          && isValidProjectConfiguration(incoming(), projectId, configId)
          && existing().userId == request.auth.uid
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().userId == existing().userId
          && incoming().variableKey == existing().variableKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'maskedValue',
            'isConfigured',
            'scope',
            'updatedAt'
          ])
          && isParentProjectOwner(projectId);

        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(configId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);
      }

      // ── /projects/{projectId}/implementationPlans/{planId} ────────
      match /implementationPlans/{planId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(planId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);

        allow list: if isSignedIn()
          && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(planId)
          && isValidImplementationPlan(incoming(), projectId, planId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentProjectOwner(projectId);

        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(planId)
          && isValidImplementationPlan(incoming(), projectId, planId)
          && existing().userId == request.auth.uid
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'approved',
            'estimatedFilesCount',
            'estimatedDurationSeconds',
            'stepsCount',
            'updatedAt'
          ])
          && isParentProjectOwner(projectId);

        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(planId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);
      }

      // ── /projects/{projectId}/workspaces/{workspaceId} ────────────
      match /workspaces/{workspaceId} {
        allow get: if isSignedIn()
          && isValidId(projectId)
          && isValidId(workspaceId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);

        allow list: if isSignedIn()
          && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(workspaceId)
          && isValidWorkspaceInstance(incoming(), projectId, workspaceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentProjectOwner(projectId);

        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(workspaceId)
          && isValidWorkspaceInstance(incoming(), projectId, workspaceId)
          && existing().userId == request.auth.uid
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'allocatedPort',
            'processId',
            'previewUrl',
            'filesCount',
            'lastCommand',
            'updatedAt'
          ])
          && isParentProjectOwner(projectId);

        allow delete: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(workspaceId)
          && existing().userId == request.auth.uid
          && isParentProjectOwner(projectId);
      }
    }
  }
}

